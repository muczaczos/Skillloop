# Copy this file to .env before running Docker Compose:
#   cp .env.example .env
# Never commit .env. Keep only non-secret placeholders in this file.
#
# Docker Compose passes each variable only to the service that needs it
# (see the `environment` sections in docker-compose.yml).

# --- Backend (server-only, never exposed to the browser) ---
ENVIRONMENT=development
# Comma-separated list of browser origins allowed to call the API.
BACKEND_CORS_ORIGINS=http://localhost:3000
# Supabase project URL; used to derive the JWT issuer and the JWKS endpoint.
SUPABASE_URL=https://<project-ref>.supabase.co
# Expected "aud" claim of Supabase access tokens.
SUPABASE_JWT_AUDIENCE=authenticated
# SECRET. Postgres connection string (Supavisor Session pooler, IPv4).
DATABASE_URL=postgresql://<db-user>.<project-ref>:<password>@<pooler-host>:5432/postgres

# --- Frontend (public, embedded in the browser bundle; never put secrets here) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
